# Copy this file to .env and fill in real values. .env itself is gitignored -
# never commit real secrets.

# Port the Express server listens on
PORT=3000

# MongoDB connection string. Local dev:
#   mongodb://localhost:27017/rummikub
# If you run Mongo in Docker instead:
#   docker run -d -p 27017:27017 --name rummikub-mongo mongo:7
MONGO_URI=mongodb://localhost:27017/rummikub

# Secret used to sign JWTs. Any long random string - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate this before submission, same as the Roboflow API key.
JWT_SECRET=replace_me_with_a_random_secret

# How long an issued token stays valid (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=7d

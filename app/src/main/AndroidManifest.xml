<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- needed for: Roboflow calls, and now the app server (login/history) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CaptureActivity requests this at runtime too (Manifest.permission.CAMERA
         check) - but the runtime request only works if the permission is also
         declared here. Without this line the permission dialog would never
         even appear. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- declares camera as used but not strictly required, so the app still
         installs on a device/emulator without one (e.g. for reviewing a
         previously-saved turn) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RummikubSolver"
        android:usesCleartextTraffic="true">

        <!-- real entry point of the app now - was MainActivity (the empty
             Android Studio template activity) until the UI screens existed -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.CaptureActivity" android:exported="false" />
        <activity android:name=".ui.ReviewActivity" android:exported="false" />
        <activity android:name=".ui.SolutionActivity" android:exported="false" />
        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.HistoryDetailActivity" android:exported="false" />

        <!-- kept registered (not launcher anymore) so the project still builds -
             this is the unused Android Studio template screen. Worth deleting
             along with activity_main.xml once nothing references it, but not
             touching that in this pass since it's cosmetic, not a bug. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>
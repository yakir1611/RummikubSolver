<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_set_container"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/textSetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/text_secondary" />

    <!-- a full 13-tile run is wider than the screen - let it scroll sideways
         instead of clipping the tiles that don't fit -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <!-- columnCount set at runtime. wrap_content (not match_parent) so
             the grid can actually grow past the screen width and trigger
             the scroll above, instead of being clipped to it. -->
        <GridLayout
            android:id="@+id/setTiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="6" />
    </HorizontalScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/textGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Rummi.Title" />

        <TextView
            android:id="@+id/textGameDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Rummi.Body" />

        <!-- context photo of the board when this turn was saved - only
             present on entries saved before the photo was dropped in favor
             of the four tile-rendered sections below (see SolutionActivity) -->
        <TextView
            android:id="@+id/labelPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/history_detail_photo_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/brand_primary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageBoardPhoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_set_container"
            android:scaleType="centerCrop"
            android:contentDescription="@string/history_detail_photo_title" />

        <!-- the same four sections SolutionActivity showed when this was saved -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/solution_board_before"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/boardBeforeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/solution_hand_before"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/handBeforeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/solution_board_after"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/brand_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/boardAfterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/solution_hand_remaining"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/brand_accent"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/handRemainingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
